import java.util.*;
public class Main{
    public static void main(String args[]){
        Scanner sc=new Scanner(System.in);
        String name;
        String password;
        int session=1;
        int choice;
        System.out.print("Username: ");
        name=sc.nextLine();
        System.out.println();
        System.out.print("Password: ");
        password=sc.nextLine();
        System.out.println(name+" logged in");
        Fooditem[] f=new Fooditem[20];
        while(true){
            System.out.println("Choose your Role: ");
            System.out.println("1-Donor");
            System.out.println("2-Reciver");
            System.out.println("3-Exit");
            choice=sc.nextInt();
            sc.nextLine();
            int i=0;
        switch(choice){ 
            case 1:
                if(session==0){
                System.out.print("Username: ");
                name=sc.nextLine();
                System.out.println();
                System.out.print("Password: ");
                password=sc.nextLine();
                }
                Donor d=new Donor(name,password);
                int x;
                while(true){
                    System.out.println("1-Post-Food      2-Logout");
                    x=sc.nextInt();
                    if(x==1){
                       System.out.println("-------POST FOOD ITEMS--------");
                        while(true){
                        f[i]=new Fooditem();
                        f[i].items();
                            i++;break;
                    }
                    }
                    else if(x==2){
                        d.logout();
                        session=0;break;
                    }
                    else{
                        System.out.println("Invalid choice");
                    }
                }break;
            case 2:
                if(session==0){
                System.out.print("Username: ");
                name=sc.nextLine();
                System.out.println();
                System.out.print("Password: ");
                password=sc.nextLine();
                }
                Receiver r=new Receiver(name,password);
                int y;
                while(true){
                    System.out.println("1-View Food-Post      2-Logout");
                    y=sc.nextInt();
                    if(y==1){
                      // System.out.prinln("-------AVAILABLE FOOD ITEMS------------");
                        Fooditem f1=f[0].object();
                        r.ViewFoodPost(f1);
                    }
                    else if(y==2){
                        r.logout();
                        session=0;
                        break;}
                        else{
                            System.out.println("Invalid choice");}
                }break;
            case 3: 
                sc.close();
                return;
            default:System.out.println("Invalid choice");
        }
        
    }
    
    }
}


abstract class User{
    String name;
    String gmail;
    long number;
    String password;
    User(){
        System.out.println("---------ELLARUKUM UNAVU-----------");
    }
    User(String name,String gmail,long number){
        this.name=name;
        this.gmail=gmail;
        this.number=number;
    }
    Scanner sc=new Scanner(System.in);
    void login(){
        System.out.print("Username: ");
        name=sc.nextLine();
        System.out.println();
        System.out.print("Password: ");
        password=sc.nextLine();
        System.out.println(name+" logged in");
    }
    abstract void logout();
}
