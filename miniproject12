class Passwordverifier{
    String passwordverifier(Scanner sc){
        String password;
        while(true){
        System.out.print("Password: ");
        password=sc.nextLine();
        if(password.matches(".*[a-z]+.*")){
            if(password.matches(".*[A-Z]+.*")){
                if(password.matches(".*\\d+.*")){
                    if(password.matches(".*[^a-zA-Z\\d\\s]+.*")){
                        if(password.matches(".{8,}"))
                            break;
                        else
                            System.out.println("Password must contains atleast 8 characters");continue;
                        }
                    else{
                        System.out.println("Password must contains atleast one special character");continue;}
                }
                else{
                    System.out.println("Password must contains atleast one digit");continue;}
                }
            else{
                System.out.println("Password must contains atleast one uppercase character");continue;}
                }
        else{
            System.out.println("Password must contains atleast one lowercase character");continue;}
        }
        return password;
    }
}
