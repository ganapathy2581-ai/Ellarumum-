class Fooditem implements Serializable{
    String fooditem;
    int quantity;
    String address;
    long mobile;
    void items() {
    Scanner sc=new Scanner(System.in);
    System.out.print("Enter the Food Item: ");
    fooditem=sc.nextLine();
    while(true){
    try{
    System.out.print("Enter the Quantity: ");
    quantity=sc.nextInt();
    sc.nextLine();break;
    }
    catch(InputMismatchException e){
        System.out.println("Enter the valid input");
        sc.nextLine();
    }
    }
    System.out.print("Enter the Address: ");
    address=sc.nextLine();
    while(true){
    try{
     System.out.print("Enter the Mobile Number:");
    mobile=sc.nextLong();
    if(String.valueOf(mobile).matches("\\d{10}")) break;
    else{System.out.println("Invalid Number");continue;}
    }
    catch(InputMismatchException e){
        System.out.println("Invalid input");
        sc.nextLine();
    }
    }
    }
    void display(){
        System.out.println(" --------------------------------------------");
        System.out.println("|  Food Item: "+ fooditem + " ".repeat(31-fooditem.length())+"|");
        System.out.println("|  Quantity: "+quantity+" ".repeat(32-String.valueOf(quantity).length())+"|");
        System.out.println("|  Address: "+address+ " ".repeat(33-address.length())+"|");
        System.out.println("|  Mobile Number: "+mobile+" ".repeat(17)+"|");
        System.out.println(" --------------------------------------------");
       // Foodpost.ViewFoodPost(this);
    }
    Fooditem object(){
        return this;
        }
}
class Profile  {
    void profile(){
        Personalinfo pi =new Personalinfo();
        Scanner sc=new Scanner(System.in);
        System.out.println("-------------PROFILE--------------");
        System.out.print("Name:");
        pi.name=sc.nextLine();
        while(true){
        System.out.print("Email:");
        pi.gmail=sc.nextLine();
        if(pi.gmail.matches(".+@gmail\\.com")) break;
        else {System.out.println("Invalid Gmail Format");continue;}
        }
        while(true){
        System.out.print("Number:");
        pi.number=sc.nextLong();
        sc.nextLine();
        if(String.valueOf(pi.number).matches("\\d{10}"))break;
        else{System.out.println("Invalid Number");continue;}
        }
        System.out.print("Address:");
        pi.address=sc.nextLine();
        System.out.print("Landmark:");
        pi.landmark=sc.nextLine();
        while(true){
        System.out.print("Pincode:");
        pi.pincode=sc.nextInt();
        if(String.valueOf(pi.pincode).matches("\\d{6}")) break;
        else{System.out.println("Invalid Pincode");continue;}
        }
    }
} 
